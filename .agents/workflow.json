{
  "schema_version": 1,
  "sources": {
    "constraints": ".specify/memory/constitution.md",
    "catalog_and_routing": ".agents/workflow.json",
    "feature_selection": ".specify/feature.json",
    "command_sources": ".specify/commands",
    "pinned_skill_sources": "scripts/setup-agent.sh",
    "verification": ".agents/skills/verify-signaltty/SKILL.md",
    "development": "docs/17-agent-development.md"
  },
  "routes": {
    "research": {
      "label": "Investigate a question",
      "first": [
        "research",
        "how"
      ],
      "conditional": [
        "why for architectural rationale"
      ],
      "documents": [
        "docs/README.md"
      ],
      "commands": []
    },
    "specify": {
      "label": "Specify a feature",
      "first": [
        "speckit-specify",
        "speckit-clarify"
      ],
      "conditional": [
        "domain-modeling for new concepts"
      ],
      "documents": [
        ".specify/memory/constitution.md",
        "specs/README.md"
      ],
      "commands": []
    },
    "design": {
      "label": "Design a substantial change",
      "first": [
        "speckit-plan",
        "architect"
      ],
      "conditional": [
        "codebase-design for module boundaries"
      ],
      "documents": [
        "docs/11-crates.md"
      ],
      "commands": []
    },
    "tasks": {
      "label": "Break down work",
      "first": [
        "speckit-tasks"
      ],
      "conditional": [
        "to-issues only when publishing issues is requested"
      ],
      "documents": [
        ".specify/memory/constitution.md"
      ],
      "commands": []
    },
    "implement": {
      "label": "Implement",
      "first": [
        "implement",
        "tdd",
        "karpathy-guidelines"
      ],
      "conditional": [
        "principle-* for a concrete design or failure"
      ],
      "documents": [
        "docs/17-agent-development.md"
      ],
      "commands": [
        [
          "scripts/verify.sh",
          "fast"
        ]
      ]
    },
    "review": {
      "label": "Review a diff",
      "first": [
        "code-review"
      ],
      "conditional": [
        "interrogate for adversarial review",
        "blast-radius for cross-module risk"
      ],
      "documents": [
        ".specify/memory/constitution.md"
      ],
      "commands": []
    },
    "verify": {
      "label": "Verify a change",
      "first": [
        "verify-signaltty",
        "principle-prove-it-works"
      ],
      "conditional": [
        "maintain-verification-skill when coverage changes"
      ],
      "documents": [
        ".agents/skills/verify-signaltty/SKILL.md",
        "docs/17-agent-development.md"
      ],
      "commands": [
        [
          "scripts/verify.sh",
          "full"
        ]
      ]
    },
    "gui": {
      "label": "Change GTK visuals",
      "first": [
        "frontend-design",
        "emil-design-eng"
      ],
      "conditional": [
        "motion/prototype skills for those changes"
      ],
      "documents": [
        "docs/06-gui-toolkit.md",
        "docs/14-product-direction.md",
        "docs/16-visual-references.md",
        "docs/17-agent-development.md"
      ],
      "commands": [
        [
          "scripts/verify.sh",
          "full"
        ]
      ]
    },
    "diagnose": {
      "label": "Diagnose a failure",
      "first": [
        "diagnosing-bugs"
      ],
      "conditional": [
        "figure-it-out when no narrower workflow fits"
      ],
      "documents": [
        "docs/17-agent-development.md"
      ],
      "commands": [
        [
          "scripts/verify.sh",
          "doctor"
        ]
      ]
    },
    "docs": {
      "label": "Write documentation",
      "first": [
        "technical-writing"
      ],
      "conditional": [
        "writing-for-agents for instructions or skills"
      ],
      "documents": [
        "docs/README.md",
        "docs/18-agent-workflow.md",
        "docs/19-ci-and-pull-requests.md"
      ],
      "commands": [
        [
          "scripts/agent.sh",
          "check",
          "--phase",
          "repository"
        ]
      ]
    },
    "core": {
      "label": "Change pure domain logic",
      "first": [
        "implement",
        "tdd",
        "karpathy-guidelines"
      ],
      "conditional": [],
      "documents": [
        "docs/02-data-model.md",
        "docs/03-lifecycle-attention.md",
        "docs/11-crates.md"
      ],
      "commands": [
        [
          "cargo",
          "test",
          "-p",
          "signaltty-core"
        ]
      ]
    },
    "ipc": {
      "label": "Change IPC contracts",
      "first": [
        "implement",
        "tdd",
        "karpathy-guidelines"
      ],
      "conditional": [],
      "documents": [
        "docs/08-ipc.md",
        "docs/02-data-model.md"
      ],
      "commands": [
        [
          "cargo",
          "test",
          "-p",
          "signaltty-server"
        ]
      ]
    },
    "workflow": {
      "label": "Change agent tooling",
      "first": [
        "implement",
        "tdd",
        "writing-for-agents"
      ],
      "conditional": [],
      "documents": [
        "docs/15-agent-skills.md",
        "docs/17-agent-development.md",
        "docs/18-agent-workflow.md",
        "docs/19-ci-and-pull-requests.md"
      ],
      "commands": [
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "scripts/tests",
          "-v"
        ]
      ]
    }
  },
